{
  "name": "diting-agent",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx apps/server/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/apps/server/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test --test-concurrency=1 tests-ts/*.test.ts",
    "test:reliability": "node --import tsx --test --test-concurrency=1 tests-ts/reliability.test.ts",
    "runtime:check": "tsx scripts/runtime-check.ts",
    "sentiment:setup": "node --env-file-if-exists=.env --import tsx scripts/setup-sentiment.ts",
    "sentiment:check": "node --env-file-if-exists=.env --import tsx scripts/check-sentiment.ts",
    "test:acceptance": "node --env-file-if-exists=.env --import tsx scripts/acceptance.ts --native --browser",
    "test:browser": "node --env-file-if-exists=.env --import tsx scripts/browser-check.ts",
    "sampling:setup": "node --env-file-if-exists=.env --import tsx scripts/setup-sampling.ts",
    "sampling:check": "node --env-file-if-exists=.env --import tsx scripts/check-sampling.ts",
    "soak:status": "node --env-file-if-exists=.env --import tsx scripts/soak-status.ts"
  },
  "dependencies": {
    "@fastify/static": "8.3.0",
    "@huggingface/transformers": "4.3.1",
    "cron-parser": "5.4.0",
    "fastify": "5.6.2",
    "ffmpeg-static": "^5.3.0",
    "jsdom": "^27.2.0",
    "playwright": "^1.64.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "24.10.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
