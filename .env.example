# Node.js 24+; copy this file to .env to override defaults.
# No .env from a reference repository is loaded.
DITING_PORT=8090
DITING_DATA_DIR=./data
# Absolute path to a locally built DeepSeek Harness checkout (required only for dsh research runs).
# Auto-detects vendor/deepseek-harness or ../deepseek-harness when built there.
# The legacy development-machine path is used only if its built SDK actually exists.
# DITING_DSH_ROOT=C:/path/to/deepseek-harness
DITING_RUNTIME_ENABLED=false
# Optional local report PDF renderer:
# DITING_CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
# Set model/API keys in the console; they are encrypted by the server.
# Optional local HTTP proxy for retrying a timed-out fixed-origin hotlist request.
# Platform refusals, login pages and invalid lists are never treated as success.
# DITING_HOTLIST_PROXY_URL=http://127.0.0.1:7897
