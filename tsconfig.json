{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "declaration": true
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "scripts/*.ts", "tests-ts/*.ts"],
  "exclude": ["node_modules", "dist", "prototypes", "tmp"]
}
